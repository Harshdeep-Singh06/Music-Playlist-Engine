<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*" %><%List<Map<String,Object>> songs=(List<Map<String,Object>>)request.getAttribute("songs");%><!DOCTYPE html><html><head><title>Playlist</title><link rel="stylesheet" href="assets/style.css"></head><body><header><a href="dashboard">← Dashboard</a><div class="brand">♫ SoundSpace</div><a href="logout">Log out</a></header><main><section class="hero"><div><small>YOUR COLLECTION</small><h1><%=request.getAttribute("playlistName")%></h1><p><%=songs.size()%> songs</p></div><div class="vinyl">▤</div></section><section class="panel"><h2>Tracks</h2><%if(songs.isEmpty()){%><p>This playlist is empty. Add songs from Discover.</p><%}%><%for(Map<String,Object>s:songs){%><div class="song"><div class="art">♫</div><div class="grow"><b><%=s.get("title")%></b><small><%=s.get("artist")%></small></div><form action="playlists/remove-song" method="post"><input type="hidden" name="playlistId" value="<%=request.getAttribute("playlistId")%>"><input type="hidden" name="songId" value="<%=s.get("id")%>"><button>Remove</button></form></div><%}%></section></main></body></html>