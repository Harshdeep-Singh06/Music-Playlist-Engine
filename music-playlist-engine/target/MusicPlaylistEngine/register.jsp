<%@ page contentType="text/html;charset=UTF-8" %><!DOCTYPE html><html><head><title>Register - SoundSpace</title><link rel="stylesheet" href="assets/style.css"></head><body class="auth"><div class="card"><div class="brand">♫ SoundSpace</div><h1>Create account</h1><%if(request.getAttribute("error")!=null){%><div class="error"><%=request.getAttribute("error")%></div><%}%><form method="post" action="register"><label>Username</label><input name="username" required><label>Email</label><input type="email" name="email" required><label>Password (6+ characters)</label><input type="password" name="password" minlength="6" required><button>Create account</button></form><p>Already registered? <a href="login">Log in</a></p></div></body></html>