<%@ page contentType="text/html;charset=UTF-8" %><!DOCTYPE html><html><head><title>Login - SoundSpace</title><link rel="stylesheet" href="assets/style.css"></head><body class="auth"><div class="card"><div class="brand">♫ SoundSpace</div><h1>Welcome back</h1><p>Log in to your music world.</p><%if(request.getAttribute("error")!=null){%><div class="error"><%=request.getAttribute("error")%></div><%}%><%if("1".equals(request.getParameter("registered"))){%><div class="success">Account created. Log in now.</div><%}%><form method="post" action="login"><label>Email</label><input type="email" name="email" required><label>Password</label><input type="password" name="password" required><button>Log in</button></form><p>New here? <a href="register">Create an account</a></p></div></body></html>